<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit <%= event.eventName %></title>
</head>
<body>
  <h1>Edit Event</h1>
  <form action="/events/<%= event._id %>" method="POST">
    <input type="hidden" name="_method" value="PUT" />
    <div>
      <label for="eventName">Event Name (immutable)</label><br />
      <input type="text" id="eventName" name="eventName" value="<%= event.eventName %>" disabled />
    </div>
    <div>
      <label for="location">Location</label><br />
      <input type="text" id="location" name="location" value="<%= event.location %>" required />
    </div>
    <div>
      <label for="eventDate">Event Date</label><br />
      <input type="date" id="eventDate" name="eventDate" value="<%= new Date(event.eventDate).toISOString().split('T')[0] %>" required />
    </div>
    <div>
      <label for="description">Description</label><br />
      <textarea id="description" name="description" rows="4" required><%= event.description %></textarea>
    </div>
    <div>
      <label for="maxParticipants">Max Participants</label><br />
      <input type="number" id="maxParticipants" name="maxParticipants" min="1" value="<%= event.maxParticipants %>" required />
    </div>
    <button type="submit">Update Event</button>
  </form>
  <p><a href="/events/<%= event._id %>">Cancel</a></p>
</body>
</html>